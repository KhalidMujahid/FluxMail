<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluxMail.Desktop.ViewModels"
        x:Class="FluxMail.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="FluxMail — Sign In"
        Width="420" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="avares://FluxMail.Desktop/Assets/icon.png"
        Background="#1E1E2E">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Brand header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,56,0,36" Spacing="10">
            <Border Width="72" Height="72" CornerRadius="36" Background="#CBA6F720" HorizontalAlignment="Center">
                <TextBlock Text="F" FontSize="38" FontWeight="Bold" Foreground="#CBA6F7"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FluxMail" FontSize="28" FontWeight="Bold" Foreground="#CDD6F4"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Sign in to continue" FontSize="13" Foreground="#6C7086"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="48,0" Spacing="14">

            <StackPanel Spacing="6">
                <TextBlock Text="Email Address" FontSize="12" Foreground="#6C7086" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Email}" PlaceholderText="you@example.com"
                         Background="#313244" Foreground="#CDD6F4" CornerRadius="8"
                         BorderBrush="#45475A" Padding="12,10" FontSize="14"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Password" FontSize="12" Foreground="#6C7086" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Password}" PasswordChar="●"
                         PlaceholderText="Your password"
                         Background="#313244" Foreground="#CDD6F4" CornerRadius="8"
                         BorderBrush="#45475A" Padding="12,10" FontSize="14"/>
            </StackPanel>

            <!-- Error message -->
            <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#F38BA820" CornerRadius="8" Padding="12,10">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F38BA8" FontSize="13"/>
            </Border>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Margin="48,24,48,56" Spacing="12">
            <Button Content="Sign In"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#CBA6F7" Foreground="#1E1E2E"
                    FontWeight="SemiBold" FontSize="15"
                    CornerRadius="8" Padding="0,14"/>
        </StackPanel>
    </Grid>
</Window>
